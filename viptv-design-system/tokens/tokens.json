{
  "$description": "VIPTV design tokens. Dark-only UI. One accent (user-selectable). Values come from the redesign canvas; bracketed notes mark proposals.",
  "color": {
    "bg": {
      "$type": "color",
      "$value": "#0B0B0C",
      "$description": "App ground. OLED mode swaps it for #000000."
    },
    "bg-oled": {
      "$type": "color",
      "$value": "#000000",
      "$description": "OLED mode ground (device setting)."
    },
    "surface": {
      "1": {
        "$type": "color",
        "$value": "#161618",
        "$description": "Cards, fields, sheets, dialogs, panels."
      },
      "2": {
        "$type": "color",
        "$value": "#212124",
        "$description": "Hover/pressed rows, nested fills."
      },
      "3": {
        "$type": "color",
        "$value": "#2A2A2E",
        "$description": "Secondary buttons, selected chip, avatars."
      },
      "4": {
        "$type": "color",
        "$value": "#34343A",
        "$description": "Secondary button hover (desktop)."
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "#F4F2EE",
        "$description": "Titles, labels, off-white fills (selected segment, TV focus)."
      },
      "body": {
        "$type": "color",
        "$value": "#DAD8D3",
        "$description": "Long-form body copy / synopsis."
      },
      "secondary": {
        "$type": "color",
        "$value": "#B6B4AF",
        "$description": "Meta, unselected nav labels, values."
      },
      "tertiary": {
        "$type": "color",
        "$value": "#8F8D89",
        "$description": "Captions, hints, placeholders. Never below 12 px."
      }
    },
    "on": {
      "light": {
        "$type": "color",
        "$value": "#111113",
        "$description": "Text on off-white fills (selected segment, TV focus, light pill)."
      },
      "accent": {
        "$type": "color",
        "$value": "#15130F",
        "$description": "Text/icons on the accent fill."
      }
    },
    "accent": {
      "default": {
        "$type": "color",
        "$value": "#F5C542",
        "$description": "Primary action, progress, spinners, caret, best-match label. Exactly one accent primary per screen."
      },
      "options": {
        "gold": {
          "$type": "color",
          "$value": "#F5C542"
        },
        "coral": {
          "$type": "color",
          "$value": "#FF8B5C"
        },
        "mint": {
          "$type": "color",
          "$value": "#62D9BC"
        },
        "periwinkle": {
          "$type": "color",
          "$value": "#A3BCFF"
        }
      }
    },
    "status": {
      "live": {
        "$type": "color",
        "$value": "#FF5A4E",
        "$description": "LIVE badge/dot only."
      },
      "danger": {
        "$type": "color",
        "$value": "#FF7A6E",
        "$description": "Destructive text, errors (phone/desktop)."
      },
      "danger-tv": {
        "$type": "color",
        "$value": "#FF8A7E",
        "$description": "Destructive/error text on TV (brighter for 10-foot)."
      },
      "spinner-track": {
        "$type": "color",
        "$value": "#45454B"
      }
    },
    "line": {
      "hairline": {
        "$type": "color",
        "$value": "rgba(255,255,255,0.07)",
        "$description": "Dividers, card/field borders, title-bar edge."
      },
      "chip": {
        "$type": "color",
        "$value": "rgba(255,255,255,0.10)",
