      },
      "outline": {
        "$type": "color",
        "$value": "rgba(255,255,255,0.14)",
        "$description": "Outline dropdown / icon chip border."
      },
      "strong": {
        "$type": "color",
        "$value": "rgba(255,255,255,0.22)",
        "$description": "Selected chip border, focused field border."
      }
    },
    "fill": {
      "tv-unfocused": {
        "$type": "color",
        "$value": "rgba(255,255,255,0.12)",
        "$description": "TV buttons/pills without focus."
      },
      "tv-selected": {
        "$type": "color",
        "$value": "rgba(255,255,255,0.16)",
        "$description": "TV chip selected but not focused."
      },
      "glass": {
        "$type": "color",
        "$value": "rgba(32,32,35,0.94)",
