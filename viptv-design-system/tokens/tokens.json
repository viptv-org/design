      },
      "tv-menu": {
        "$type": "color",
        "$value": "rgba(0,0,0,0.55)",
        "$description": "TV expanded menu."
      },
      "tv-fullscreen": {
        "$type": "color",
        "$value": "rgba(11,11,12,0.94)",
        "$description": "TV full-screen text entry / text panel."
      }
    }
